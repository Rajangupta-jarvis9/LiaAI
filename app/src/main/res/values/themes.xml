<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: no action bar; Compose handles everything -->
    <style name="Theme.LiaAI" parent="android:Theme.Material.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme applied to MainActivity before Compose draws -->
    <style name="Theme.LiaAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.LiaAI</item>
    </style>
</resources>
